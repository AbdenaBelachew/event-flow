# ---- Server ----
PORT=4000
NODE_ENV=development
# Public base URL of THIS backend (used to build payment webhook callback URLs)
APP_BASE_URL=http://localhost:4000

# ---- Database ----
# Either provide a full connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketing
# ...or the individual parts (DATABASE_URL takes precedence if set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ticketing
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Payment gateways ----
# Chapa (https://developer.chapa.co). If CHAPA_SECRET_KEY is empty the gateway
# runs in SIMULATION mode so the full sales -> payment -> ticket flow still works.
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1

# Telebirr / CBE Birr are stubbed (simulation) behind the same interface.
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_API_KEY=

# Rate limiting on the check-in endpoint (per staff IP)
CHECKIN_RATE_WINDOW_MS=10000
CHECKIN_RATE_MAX=30
